---
import type { OfficeEntry } from "../lib/offices";
import { getLangFromPath, localizedOfficePath, localizedOfficeValue, localizedTax, siteText } from "../lib/i18n";

const { offices } = Astro.props as { offices: OfficeEntry[] };
const lang = getLangFromPath(Astro.url.pathname);
const copy = siteText[lang].offices;
const formatRentRate = (value: number) => value > 0 ? "$" + new Intl.NumberFormat(lang === "ru" ? "ru-RU" : lang === "uz" ? "uz-UZ" : "en-US", { maximumFractionDigits: 2 }).format(value) + " / " + copy.perMonth : copy.onRequest;
const preparedOffices = offices.map((office) => ({
  office,
  images: Array.from(new Set([office.data.mainImage, ...(office.data.gallery ?? [])].filter(Boolean))),
}));
const firstOffice = preparedOffices[0];
---

<section id="offices" class="section offices-section">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h2>{copy.heading}</h2>
    </div>

    <div class="offices-browser" data-offices-browser data-default-title={copy.office}>
      <figure class="office-hover-gallery">
        <img
          src={firstOffice?.images[0] ?? ""}
          alt={firstOffice ? localizedOfficeValue(firstOffice.office.data, "title", lang) : copy.office}
          data-office-preview
          class="is-visible"
        />
        <figcaption data-office-preview-caption>{firstOffice ? localizedOfficeValue(firstOffice.office.data, "title", lang) : ""}</figcaption>
      </figure>

      <div class="table-wrap" aria-label={copy.table}>
        <table class="offices-table">
          <thead>
            <tr>
              <th>{copy.floor}</th>
              <th>{copy.area}</th>
              <th>{copy.rent}</th>
              <th>{copy.workplaces}</th>
              <th>{copy.readiness}</th>
            </tr>
          </thead>

          <tbody>
            {preparedOffices.map(({ office, images }) => (
              <tr
                class="office-option-row"
                data-office-row
                data-images={JSON.stringify(images)}
                data-title={localizedOfficeValue(office.data, "title", lang)}
                data-image-alt={office.data.imageAlt}
                data-target={localizedOfficePath(office.data.pageSlug, lang)}
                tabindex="0"
              >
                <td data-label={copy.floor}>{office.data.floor}</td>
                <td data-label={copy.area}>{office.data.area} м²</td>
                <td data-label={copy.rent}><span class="rent-rate"><strong>{formatRentRate(office.data.rentRate)}</strong><small>{copy.excluding} {localizedTax(office.data.rentTax, lang)}.</small></span></td>
                <td data-label={copy.workplaces}>{localizedOfficeValue(office.data, "workplaces", lang)}</td>
                <td data-label={copy.readiness}>{localizedOfficeValue(office.data, "ready", lang)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector("[data-offices-browser]");
  if (root instanceof HTMLElement) {
    const preview = root.querySelector("[data-office-preview]");
    const caption = root.querySelector("[data-office-preview-caption]");
    const rows = Array.from(root.querySelectorAll("[data-office-row]"));
    const desktop = window.matchMedia("(min-width: 901px)");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let timer = 0;

    const stop = () => {
      if (timer) window.clearInterval(timer);
      timer = 0;
    };

    const showImage = (src, alt, immediate = false) => {
      if (!(preview instanceof HTMLImageElement) || !src) return;
      const apply = () => {
        preview.src = src;
        preview.alt = alt;
        preview.classList.add("is-visible");
      };
      if (immediate || reduceMotion) {
        apply();
        return;
      }
      preview.classList.remove("is-visible");
      window.setTimeout(apply, 180);
    };

    const activate = (row) => {
      if (!(row instanceof HTMLElement) || !desktop.matches) return;
      let images = [];
      try {
        const parsed = JSON.parse(row.dataset.images || "[]");
        images = Array.isArray(parsed) ? parsed.filter(Boolean) : [];
      } catch {
        images = [];
      }
      if (!images.length) return;
      stop();
      rows.forEach((item) => item.classList.toggle("is-active", item === row));
      const title = row.dataset.title || root.dataset.defaultTitle || "Trilliant";
      const alt = row.dataset.imageAlt || title;
      if (caption) caption.textContent = title;
      images.forEach((src) => {
        const image = new Image();
        image.src = src;
      });
      let index = 0;
      showImage(images[index], alt, true);
      if (images.length > 1 && !reduceMotion) {
        timer = window.setInterval(() => {
          index = (index + 1) % images.length;
          showImage(images[index], alt);
        }, 1000);
      }
    };

    rows.forEach((row) => {
      row.addEventListener("mouseenter", () => activate(row));
      row.addEventListener("focus", () => activate(row));
      row.addEventListener("mouseleave", stop);
      row.addEventListener("blur", stop);
      row.addEventListener("click", () => {
        const target = row instanceof HTMLElement ? row.dataset.target : "";
        if (target) window.location.href = target;
      });
      row.addEventListener("keydown", (event) => {
        if (event.key !== "Enter" && event.key !== " ") return;
        event.preventDefault();
        const target = row instanceof HTMLElement ? row.dataset.target : "";
        if (target) window.location.href = target;
      });
    });

    if (rows[0]) activate(rows[0]);
    desktop.addEventListener("change", (event) => {
      stop();
      if (event.matches && rows[0]) activate(rows[0]);
    });
  }
</script>
