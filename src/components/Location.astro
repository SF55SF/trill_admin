---
import { getLangFromPath, siteText } from "../lib/i18n";
const copy = siteText[getLangFromPath(Astro.url.pathname)].location;
---
<section id="location" class="section section-muted">
  <div class="container two-col location-grid">
    <div><p class="eyebrow">{copy.eyebrow}</p><h2>{copy.heading}</h2><div class="route-list"><article><strong>{copy.address}</strong><span>{copy.addressValue}</span></article><article><strong>{copy.city}</strong><span>{copy.cityValue}</span></article><article><strong>{copy.route}</strong><span>{copy.routeValue}</span></article></div></div>
    <div class="map-placeholder map-interaction" data-map-interaction><iframe src="https://yandex.uz/map-widget/v1/?ll=69.282683%2C41.315763&amp;mode=whatshere&amp;whatshere%5Bpoint%5D=69.282683%2C41.315763&amp;whatshere%5Bzoom%5D=17&amp;z=17" width="100%" height="450" frameborder="0" allowfullscreen="true" loading="lazy" title={copy.map} style="border:0;"></iframe><button class="map-control-button" type="button" data-map-control aria-pressed="false">{copy.control}</button></div>
  </div>
</section>
<script is:inline src="/js/map-control.js"></script>
