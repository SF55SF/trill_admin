---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Contact from "./Contact.astro";
import Footer from "./Footer.astro";
import { absoluteUrl, homeAnchor, relativePath } from "../lib/paths";
import { localizedHome, localizedOfficeArray, localizedOfficePath, localizedOfficeValue, localizedTax, siteText, type Lang } from "../lib/i18n";
import { getPublishedOffices } from "../lib/offices";
const { office, lang } = Astro.props as { office: CollectionEntry<"offices">; lang: Lang };
const data = office.data;
const copy = siteText[lang];
const rawTitle = localizedOfficeValue(data, "detailTitle", lang);
const displayTitle = rawTitle.startsWith("Офисный блок ") ? rawTitle.slice("Офисный блок ".length) : rawTitle;
const intro = localizedOfficeValue(data, "intro", lang);
const layout = localizedOfficeValue(data, "officeLayout", lang);
const detailFeatures = localizedOfficeArray(data, "detailFeatures", lang).filter((feature) => !feature.toLowerCase().includes("планировк"));
const rentRate = data.rentRate > 0 ? "$" + new Intl.NumberFormat(lang === "ru" ? "ru-RU" : lang === "uz" ? "uz-UZ" : "en-US", { maximumFractionDigits: 2 }).format(data.rentRate) + " / " + copy.detail.perMonth : copy.detail.onRequest;
const currentPath = Astro.url.pathname;
const canonical = absoluteUrl(localizedOfficePath(data.pageSlug, lang));
const mainImage = relativePath(data.mainImage, currentPath);
const planImage = data.planImage ? relativePath(data.planImage, currentPath) : "";
const gallery = data.gallery.map((image) => relativePath(image, currentPath));
const seoTitle = localizedOfficeValue(data, "seoTitle", lang) || displayTitle + " — Trilliant";
const seoDescription = localizedOfficeValue(data, "description", lang) || intro || displayTitle;
// TRILLIANT_OFFICE_SEO_V1
const allOffices = await getPublishedOffices();
const relatedOffices = allOffices
  .filter((item) => item.data.pageSlug !== data.pageSlug)
  .sort((a, b) => Math.abs(a.data.area - data.area) - Math.abs(b.data.area - data.area))
  .slice(0, 3);
const homeUrl = lang === "ru" ? "https://www.trilliant.uz/" : "https://www.trilliant.uz/" + lang + "/";
const breadcrumbsLabel = lang === "ru" ? "Навигационная цепочка" : lang === "uz" ? "Navigatsiya yo‘li" : "Breadcrumbs";
const relatedHeading = lang === "ru" ? "Другие доступные офисы" : lang === "uz" ? "Boshqa mavjud ofislar" : "Other available offices";
const contextText = lang === "ru"
  ? "Готовый офис площадью " + data.area + " м² на " + data.floor + " этаже бизнес-центра Trilliant класса А в центре Ташкента. Планировка: " + layout + ". Помещение доступно для аренды без комиссии для арендатора."
  : lang === "uz"
    ? "Toshkent markazidagi A toifali Trilliant biznes markazining " + data.floor + "-qavatida joylashgan " + data.area + " m² tayyor ofis. Rejalashtirish: " + layout + ". Ofis ijarachi uchun komissiyasiz ijaraga beriladi."
    : "A ready-to-use " + data.area + " m² office on floor " + data.floor + " at the Class A Trilliant Business Center in central Tashkent. Layout: " + layout + ". The office is available for lease with no tenant commission.";
const breadcrumbStructuredData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: copy.home, item: homeUrl },
    { "@type": "ListItem", position: 2, name: displayTitle, item: canonical }
  ]
};
const listingStructuredData = {
  "@context": "https://schema.org",
  "@type": "Place",
  name: displayTitle,
  description: seoDescription,
  url: canonical,
  image: absoluteUrl(data.mainImage),
  address: { "@type": "PostalAddress", streetAddress: copy.location.addressValue, addressLocality: copy.location.cityValue, addressCountry: "UZ" },
  additionalProperty: [
    { "@type": "PropertyValue", name: copy.offices.area, value: data.area, unitText: "m²" },
    { "@type": "PropertyValue", name: copy.offices.floor, value: data.floor },
    { "@type": "PropertyValue", name: copy.offices.layout, value: layout }
  ],
  offers: { "@type": "Offer", url: canonical, priceCurrency: "USD", availability: "https://schema.org/InStock", ...(data.rentRate > 0 ? { price: data.rentRate } : {}) }
};
---
<BaseLayout lang={lang} title={seoTitle} description={seoDescription} canonical={canonical} image={absoluteUrl(data.mainImage)}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbStructuredData)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(listingStructuredData)}></script>
  <Header />
  <main>
    <section class="section office-detail-page"><div class="container two-col"><div>
      <a class="office-back-link" href={homeUrl} aria-label={copy.home} title={copy.home}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg></a>
      <h1 class="office-detail-title">{displayTitle}</h1><p>{intro}</p><p class="office-context-copy">{contextText}</p>
      <div class="office-detail-meta office-card-topline"><p class="office-rent-box"><strong>{copy.detail.rent}</strong><span>{rentRate}</span><small>{copy.detail.excluding} {localizedTax(data.rentTax, lang)}.</small></p><a class="button button-telegram telegram-icon-button" href="https://t.me/sanjar_saymatov_cmwp" target="_blank" rel="noreferrer" aria-label={copy.telegram} title="Telegram"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9.78 18.65l.28-4.23 7.68-6.92c.34-.3-.07-.45-.52-.18L7.74 13.3 3.64 12c-.88-.25-.9-.86.2-1.3l16-6.18c.74-.27 1.4.18 1.15 1.3l-2.72 12.8c-.2.9-.74 1.12-1.5.7l-4.14-3.05-2 1.93c-.22.22-.4.4-.85.4Z" /></svg></a></div>
      <ul class="feature-list">{detailFeatures.map((feature) => <li>{feature}</li>)}</ul>
      <p class="office-layout-row"><span>{copy.detail.layout} — {layout}</span></p>
      <div class="card-actions"><a class="button button-dark" href={localizedHome(lang, "contacts")}>{copy.detail.offer}</a></div>
    </div><div class="plan-placeholder"><button class="image-open-button office-detail-main-button" type="button" data-lightbox-src={mainImage} data-lightbox-alt={localizedOfficeValue(data, "imageAlt", lang) || displayTitle} aria-label={copy.detail.openPhoto + " " + data.area + " m²"} style={`--office-main-image:url("${mainImage}")`}><img class="office-detail-main-image" src={mainImage} alt={localizedOfficeValue(data, "imageAlt", lang) || displayTitle} draggable="false" /></button></div></div></section>
    <!-- TRILLIANT_OFFICE_DETAIL_MEDIA_RATIO_V1 -->
    <section class="section office-detail-gallery-section"><div class="container"><p class="eyebrow">{copy.detail.photo}</p><h2>{copy.detail.gallery} {data.area} m²</h2><div class="mini-gallery">{gallery.map((image, index) => <div><button class="image-open-button" type="button" data-lightbox-src={image} data-lightbox-alt={copy.detail.photo + " " + (index + 1)} aria-label={copy.detail.openGalleryPhoto + " " + (index + 1)}><img class="office-detail-gallery-image" src={image} alt={copy.detail.photo + " " + (index + 1)} /></button></div>)}</div></div></section>
    <!-- TRILLIANT_DETAIL_VARIANT1_V2 -->
    {planImage && <section class="section office-detail-plan-section">
      <div class="container office-detail-plan-card">
        <div class="office-detail-plan-copy">
          <p class="eyebrow">{copy.detail.layout}</p>
          <h2>{copy.detail.layout}</h2>
          <p>{layout}</p>
        </div>
        <button class="image-open-button office-detail-plan-button" type="button" data-lightbox-src={planImage} data-lightbox-alt={copy.detail.layout + ": " + displayTitle} aria-label={copy.detail.openPhoto + " — " + copy.detail.layout}>
          <img src={planImage} alt={copy.detail.layout + ": " + displayTitle} />
        </button>
      </div>
    </section>}
    {relatedOffices.length > 0 && <section class="section related-offices">
      <div class="container">
        <p class="eyebrow">{copy.offices.eyebrow}</p>
        <h2>{relatedHeading}</h2>
        <div class="related-office-grid">
          {relatedOffices.map((item) => <a class="related-office-link" href={localizedOfficePath(item.data.pageSlug, lang)}>
            <img src={relativePath(item.data.mainImage, currentPath)} alt={localizedOfficeValue(item.data, "imageAlt", lang) || localizedOfficeValue(item.data, "title", lang)} />
            <span><strong>{localizedOfficeValue(item.data, "title", lang)}</strong><small>{item.data.area} m² · {item.data.floor}</small></span>
          </a>)}
        </div>
      </div>
    </section>}
    <Contact />
  </main>
  <Footer />
  <style>
    .office-detail-page{padding:34px 0 28px}
    .office-detail-page>.container.two-col{display:grid;width:min(1180px,calc(100% - 40px));max-width:1180px;margin-inline:auto;grid-template-columns:minmax(0,1fr) minmax(420px,.9fr);grid-template-areas:"visual panel";gap:24px;align-items:start}
    .office-detail-page>.container.two-col>div:first-child{grid-area:panel;display:flex;min-width:0;flex-direction:column;gap:16px;padding:24px;border:1px solid var(--line);border-radius:var(--radius);background:var(--surface);box-shadow:var(--shadow)}
    .office-detail-page>.container.two-col>.plan-placeholder{grid-area:visual;width:100%;min-width:0;min-height:0;aspect-ratio:16/10;overflow:hidden;border:1px solid var(--line);border-radius:var(--radius);background:var(--surface-soft);box-shadow:var(--shadow)}
    .office-detail-page>.container.two-col>.plan-placeholder .image-open-button{display:block;width:100%;height:100%;overflow:hidden}
    .office-detail-page .office-detail-main-image{display:block;width:100%;max-width:100%!important;height:100%;max-height:none!important;object-fit:cover!important;object-position:center;background:var(--surface-soft)}
    .office-breadcrumbs{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 2px;color:var(--muted);font-size:13px}
    .office-breadcrumbs a{color:inherit;text-decoration:none}
    .office-breadcrumbs a:hover{text-decoration:underline}
    .office-detail-page .eyebrow{margin:0}
    .office-detail-page h1.office-detail-title{margin:0!important;font-size:clamp(30px,3vw,42px)!important;line-height:1.08!important}
    .office-detail-page>.container.two-col>div:first-child>p:not(.eyebrow):not(.office-context-copy):not(.office-layout-row){margin:0;font-size:16px;line-height:1.58}
    .office-context-copy{display:none}
    .office-detail-page .office-card-topline{margin:0!important;border-radius:16px!important}
    .office-detail-page .feature-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin:0;padding:0}
    .office-detail-page .feature-list li{min-width:0;padding:11px 14px!important;border-radius:14px!important;background:var(--surface-soft)}
    .office-detail-page .office-layout-row{margin:0!important;border:1px solid var(--line);border-radius:14px!important;background:transparent!important}
    .office-detail-page .card-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:auto;padding:0!important}
    .office-detail-page .card-actions .button{width:100%;min-height:46px}
    .office-detail-gallery-section,.office-detail-plan-section,.related-offices{padding:28px 0}
    .office-detail-section-head{margin-bottom:18px}
    .office-detail-section-head .eyebrow{margin-bottom:6px}
    .office-detail-section-head h2{margin:0}
    .office-detail-gallery-section .mini-gallery{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
    .office-detail-gallery-section .mini-gallery>div{height:auto!important;min-height:0!important;aspect-ratio:4/3;border:1px solid var(--line);border-radius:18px;background:var(--surface-soft);overflow:hidden}
    .office-detail-gallery-image{width:100%;height:100%;object-fit:cover;object-position:center}
    .office-detail-plan-card{display:grid;grid-template-columns:minmax(240px,.34fr) minmax(0,.66fr);gap:26px;align-items:center;padding:24px;border:1px solid var(--line);border-radius:var(--radius);background:var(--surface);box-shadow:var(--shadow)}
    .office-detail-plan-copy h2{margin:8px 0 12px}
    .office-detail-plan-copy p:last-child{margin:0;color:var(--muted);font-size:17px}
    .office-detail-plan-button{display:block;width:100%;min-height:300px;padding:0;border:1px solid var(--line);border-radius:18px;background:#fff;overflow:hidden;cursor:zoom-in}
    .office-detail-plan-button img{display:block;width:100%;height:100%;max-height:420px;object-fit:contain;background:#fff}
    .related-offices{padding-top:28px}
    .related-office-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
    .related-office-link{display:grid;grid-template-columns:112px minmax(0,1fr);gap:14px;align-items:center;min-width:0;padding:12px;border:1px solid var(--line);border-radius:18px}
    .related-office-link img{display:block;width:112px;height:82px;border-radius:12px;object-fit:cover}
    .related-office-link span{display:grid;gap:5px}
    .related-office-link small{color:var(--muted)}
    .office-detail-gallery-section .mini-gallery img,img.office-detail-gallery-image{width:100%;height:100%;object-fit:cover}
    @media(max-width:1050px){.office-detail-page>.container.two-col{grid-template-columns:1fr;grid-template-areas:"visual" "panel"}.office-detail-page>.container.two-col>.plan-placeholder{aspect-ratio:16/9}.office-detail-plan-card{grid-template-columns:1fr}.related-office-grid{grid-template-columns:1fr}}
    @media(max-width:640px){.office-detail-page{padding:24px 0 18px}.office-detail-page>.container.two-col>div:first-child{gap:14px;padding:16px;border-radius:20px}.office-detail-page>.container.two-col>.plan-placeholder{width:100%;aspect-ratio:16/10;max-height:58vh;border-radius:20px;overflow:hidden}.office-detail-page h1.office-detail-title{font-size:29px!important}.office-detail-page .feature-list{grid-template-columns:1fr}.office-detail-page .card-actions{grid-template-columns:1fr}.office-detail-gallery-section,.office-detail-plan-section,.related-offices{padding:22px 0}.office-detail-gallery-section .mini-gallery{grid-template-columns:1fr}.related-office-link{grid-template-columns:92px minmax(0,1fr)}.related-office-link img{width:92px;height:72px}}
  
    

    /* TRILLIANT_DETAIL_COHESIVE_V2 */
    .office-detail-page{padding:20px 0 12px}
    .office-detail-page>.container.two-col{
      gap:16px;
      padding:16px;
      border:1px solid var(--line);
      border-radius:var(--radius);
      background:var(--surface);
      box-shadow:var(--shadow)
    }
    .office-detail-page>.container.two-col>div:first-child{
      gap:12px;
      padding:18px;
      border:0;
      border-radius:0;
      background:transparent;
      box-shadow:none
    }
    .office-detail-page>.container.two-col>.plan-placeholder{
      border:0;
      border-radius:20px;
      box-shadow:none
    }
    .office-back-link{
      display:inline-grid;
      width:42px;
      height:42px;
      place-items:center;
      margin:0 0 2px;
      border:1px solid var(--line);
      border-radius:50%;
      color:var(--text);
      font-size:26px;
      font-weight:500;
      line-height:1;
      text-decoration:none;
      transition:background .18s ease,transform .18s ease
    }
    .office-back-link:hover{
      background:var(--surface-soft);
      transform:translateX(-2px)
    }
    .office-detail-page h1.office-detail-title,
    .office-detail-page>.container.two-col>div:first-child>p:not(.office-context-copy):not(.office-layout-row){
      padding-inline:14px
    }
    .office-detail-page .office-rent-box,
    .office-detail-page .feature-list li,
    .office-detail-page .office-layout-row{
      padding-left:14px!important
    }
    .office-detail-page .card-actions{
      display:flex;
      grid-template-columns:none;
      justify-content:flex-start;
      margin:2px 0 0!important;
      padding:0 14px!important
    }
    .office-detail-page .card-actions .button{
      width:auto;
      min-width:190px;
      min-height:44px
    }
    .office-detail-gallery-section,
    .office-detail-plan-section,
    .related-offices{
      padding:18px 0
    }
    .office-detail-gallery-section h2,
    .related-offices h2{
      margin-top:5px;
      margin-bottom:16px
    }
    .office-detail-plan-card{
      gap:18px;
      padding:18px
    }
    @media(max-width:1050px){
      .office-detail-page>.container.two-col{
        grid-template-areas:"panel" "visual"
      }
      .office-detail-page>.container.two-col>.plan-placeholder{
        aspect-ratio:16/9
      }
    }
    @media(max-width:640px){
      .office-detail-page{padding:14px 0 10px}
      .office-detail-page>.container.two-col{
        width:calc(100% - 24px);
        gap:10px;
        padding:10px;
        border-radius:22px
      }
      .office-detail-page>.container.two-col>div:first-child{
        gap:11px;
        padding:12px
      }
      .office-detail-page>.container.two-col>.plan-placeholder{
        border-radius:17px
      }
      .office-back-link{
        width:38px;
        height:38px;
        font-size:23px
      }
      .office-detail-page h1.office-detail-title,
      .office-detail-page>.container.two-col>div:first-child>p:not(.office-context-copy):not(.office-layout-row){
        padding-inline:10px
      }
      .office-detail-page .office-rent-box,
      .office-detail-page .feature-list li,
      .office-detail-page .office-layout-row{
        padding-left:10px!important
      }
      .office-detail-page .card-actions{
        padding-inline:10px!important
      }
      .office-detail-page .card-actions .button{
        width:100%;
        min-width:0
      }
      .office-detail-gallery-section,
      .office-detail-plan-section,
      .related-offices{
        padding:14px 0
      }
    }

    /* TRILLIANT_FINAL_DETAIL_LAYOUT_V1_START */
    .office-detail-page {
      padding: 18px 0 20px !important;
    }

    .office-detail-page > .container.two-col {
      display: grid !important;
      width: min(1440px, calc(100% - 48px)) !important;
      max-width: 1440px !important;
      grid-template-columns: minmax(0, 1.15fr) minmax(400px, .85fr) !important;
      grid-template-areas: "visual panel" !important;
      gap: 0 !important;
      align-items: stretch !important;
      padding: 0 !important;
      overflow: hidden !important;
      border: 1px solid var(--line) !important;
      border-radius: var(--radius) !important;
      background: var(--surface) !important;
      box-shadow: var(--shadow) !important;
    }

    .office-detail-page > .container.two-col > div:first-child {
      grid-area: panel !important;
      display: flex !important;
      min-width: 0 !important;
      flex-direction: column !important;
      gap: 12px !important;
      padding: 26px 28px !important;
      border: 0 !important;
      border-radius: 0 !important;
      background: var(--surface) !important;
      box-shadow: none !important;
    }

    .office-detail-page > .container.two-col > .plan-placeholder {
      grid-area: visual !important;
      align-self: stretch !important;
      width: 100% !important;
      height: auto !important;
      min-height: 0 !important;
      aspect-ratio: auto !important;
      overflow: hidden !important;
      border: 0 !important;
      border-radius: 0 !important;
      background: var(--surface-soft) !important;
      box-shadow: none !important;
    }

    .office-detail-page > .container.two-col > .plan-placeholder .image-open-button,
    .office-detail-page > .container.two-col > .plan-placeholder .office-detail-main-image {
      display: block !important;
      width: 100% !important;
      height: 100% !important;
    }

    .office-detail-page > .container.two-col > .plan-placeholder .office-detail-main-image {
      object-fit: cover !important;
      object-position: center !important;
    }

    .office-detail-page .office-back-link {
      margin-left: 18px !important;
      margin-bottom: 2px !important;
    }

    .office-detail-page h1.office-detail-title,
    .office-detail-page > .container.two-col > div:first-child > p:not(.office-context-copy):not(.office-layout-row) {
      margin-left: 0 !important;
      margin-right: 0 !important;
      padding-left: 18px !important;
      padding-right: 18px !important;
    }

    .office-detail-page .office-card-topline {
      margin: 0 !important;
      padding: 16px 84px 16px 18px !important;
      border-radius: 14px !important;
      box-shadow: none !important;
    }

    .office-detail-page .feature-list {
      display: grid !important;
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
      gap: 8px !important;
      margin: 0 !important;
      padding: 0 !important;
    }

    .office-detail-page .feature-list li {
      min-width: 0 !important;
      padding: 12px 18px !important;
      border-radius: 14px !important;
    }

    .office-detail-page .office-layout-row {
      width: 100% !important;
      margin: 0 !important;
      padding: 13px 18px !important;
      border-radius: 14px !important;
    }

    .office-detail-page .card-actions {
      display: flex !important;
      justify-content: flex-start !important;
      margin: 2px 0 0 !important;
      padding: 0 18px !important;
    }

    .office-detail-page .card-actions .button {
      width: auto !important;
      min-width: 190px !important;
      min-height: 46px !important;
    }

    .office-detail-gallery-section,
    .office-detail-plan-section,
    .related-offices {
      padding: 20px 0 !important;
    }

    .office-detail-gallery-section > .container,
    .office-detail-plan-section > .container,
    .related-offices > .container {
      width: min(1440px, calc(100% - 48px)) !important;
      max-width: 1440px !important;
    }

    .office-detail-plan-card {
      gap: 22px !important;
      padding: 22px !important;
      border-radius: var(--radius) !important;
    }

    @media (max-width: 1050px) {
      .office-detail-page > .container.two-col {
        grid-template-columns: 1fr !important;
        grid-template-areas: "panel" "visual" !important;
      }

      .office-detail-page > .container.two-col > .plan-placeholder {
        min-height: 420px !important;
      }
    }

    @media (max-width: 640px) {
      .office-detail-page {
        padding: 12px 0 16px !important;
      }

      .office-detail-page > .container.two-col {
        width: calc(100% - 24px) !important;
        border-radius: 20px !important;
      }

      .office-detail-page > .container.two-col > div:first-child {
        padding: 18px 14px !important;
      }

      .office-detail-page > .container.two-col > .plan-placeholder {
        min-height: 260px !important;
      }

      .office-detail-page .office-back-link {
        margin-left: 12px !important;
      }

      .office-detail-page h1.office-detail-title,
      .office-detail-page > .container.two-col > div:first-child > p:not(.office-context-copy):not(.office-layout-row) {
        padding-inline: 12px !important;
      }

      .office-detail-page .office-card-topline {
        padding: 14px 72px 14px 12px !important;
      }

      .office-detail-page .feature-list {
        grid-template-columns: 1fr !important;
