---
import { navItems } from '../data/navigation';
import { homePath, resolveNavHref } from '../lib/paths';

const currentPath = Astro.url.pathname;
const logoHref = homePath(currentPath);
---

<header class="site-header">
  <a class="logo" href={logoHref} aria-label="На главную страницу">
    <span class="logo-mark"><img src="/favicon.svg" alt="" width="24" height="24" aria-hidden="true" /></span>
    <span>Trilliant</span>
  </a>

  <button
    class="menu-button"
    type="button"
    aria-label="Открыть меню"
    aria-expanded="false"
    aria-controls="main-menu"
  >
    <span class="menu-button__line"></span>
    <span class="menu-button__line"></span>
    <span class="menu-button__text">Меню</span>
  </button>

  <nav id="main-menu" class="main-nav" aria-label="Основная навигация">
    {navItems.map((item) => (
      <a href={resolveNavHref(item.href, currentPath)}>
        {item.label}
      </a>
    ))}
  </nav>

  <a class="telegram-icon-button header-telegram" href="https://t.me/sanjar_saymatov_cmwp" target="_blank" rel="noreferrer" aria-label="Написать в Telegram" title="Telegram">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21.6 3.4 18.4 19c-.2 1.1-.8 1.4-1.7.9l-4.9-3.6-2.4 2.3c-.3.3-.5.5-1 .5l.4-5 9.1-8.2c.4-.4-.1-.6-.6-.2L6.1 12.8 1.3 11.3C.3 11 .3 10.3 1.5 9.8L20.2 2.6c.9-.3 1.7.2 1.4.8Z" /></svg>
  </a>
  <div class="header-contacts">
    <a href="tel:+998505906059">+998 50 590 60 59</a>
    <a href="mailto:sanjar.saimatov@cmwp.uz">sanjar.saimatov@cmwp.uz</a>
  </div>
</header>