---
import { getPublishedOffices } from "../lib/offices";

const publishedOffices = await getPublishedOffices();
const areas = publishedOffices.map((office) => office.data.area).filter((area) => Number.isFinite(area));
const minArea = areas.length ? Math.min(...areas) : 0;
const totalArea = areas.reduce(function (sum, area) { return sum + area; }, 0);
const areaRange = minArea === totalArea ? minArea + " м²" : minArea + " – " + totalArea + " м²";
---
<section id="about" class="stats-section">
  <div class="container two-col">
    <div>
      <p class="eyebrow">О бизнес-центре</p>

      <h2>Триллиант — офисное здание класса А<br />в центре г. Ташкента</h2>

      <p>
        Бизнес-центр Trilliant предлагает готовые офисы в аренду от собственника
        в центре Ташкента.
      </p>

      <p>
        Аренда офиса осуществляется без комиссии для арендатора. Помещения
        полностью готовы к заезду: выполнен качественный ремонт, предусмотрена
        мебель и инфраструктура для комфортной работы команды.
      </p>

      <p>
        Комплекс введён в эксплуатацию, полностью функционирует и соответствует
        уровню бизнес-центра класса А. В Trilliant доступны офисные помещения
        различной площади: от готовых блоков для небольших команд до просторных
        офисов для компаний, которым важно разместить сотрудников в одном
        современном деловом пространстве.
      </p>

      <p>
        Trilliant подходит компаниям, которые ищут офис в аренду в Ташкенте
        с возможностью быстрого въезда.
      </p>
    </div>

    <div class="stats-media"><video class="stats-video" autoplay muted loop playsinline webkit-playsinline disablepictureinpicture preload="auto" oncanplay="this.muted=true;this.play()" onloadedmetadata="this.muted=true;this.play()"><source src="/videos/office-tour.mp4" type="video/mp4" /></video><div class="stats-grid">
      <article>
        <strong>Шахрисабз, 2</strong>
        <span>адрес бизнес-центра</span>
      </article>

      <article>
        <strong>A</strong>
        <span>класс здания</span>
      </article>

      <article>
        <strong>{areaRange}</strong>
        <span>диапазон доступной площади для аренды</span>
      </article>

      <article>
        <strong>Введено в эксплуатацию</strong>
        <span>готовность использования</span>
      </article>
    </div>
    </div>
  </div>
</section>