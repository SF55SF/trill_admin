---
import { getCollection } from "astro:content";
const offices=(await getCollection("offices")).sort((a,b)=>{const af=Number.parseFloat(String(a.data.floor).replace(",","."));const bf=Number.parseFloat(String(b.data.floor).replace(",","."));const floorDiff=(Number.isFinite(af)?af:Number.MAX_SAFE_INTEGER)-(Number.isFinite(bf)?bf:Number.MAX_SAFE_INTEGER);return floorDiff||a.data.area-b.data.area;});
const slug=Astro.url.searchParams.get("object");
const current=offices.find((item)=>item.data.pageSlug===slug)??offices[0];
const adminUrl=(value)=>"/admin/?object="+encodeURIComponent(value);
const adminTitle=(value)=>{const title=String(value||"").trim();if(title.startsWith("Офисный блок "))return title.slice(13);if(title.startsWith("Офис "))return title.slice(5);return title;};
---
<!-- TRILL_ADMIN_SHELL_START -->
<!doctype html><html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow,noarchive"><title>Trilliant Admin</title></head><body>
<main class="admin">
<aside><header><div><small>TRILLIANT</small><h1>Офисы</h1></div><!-- TRILL_ADMIN_NAMING_UI_START --><button type="button" data-admin-add aria-label="Добавить офис">+</button><!-- TRILL_ADMIN_NAMING_UI_END --></header><!-- TRILL_ADMIN_LIST_START --><nav data-office-list>{offices.map((item,index)=><a class:list={["item",{active:item.id===current?.id}]} data-office={JSON.stringify({pageSlug:item.data.pageSlug,published:item.data.published!==false,title:item.data.title,detailTitle:item.data.detailTitle,area:item.data.area,floor:item.data.floor,rentRate:item.data.rentRate??0,rentTax:item.data.rentTax??"НДС",workplaces:item.data.workplaces,ready:item.data.ready,officeLayout:item.data.officeLayout,intro:item.data.intro,mainImage:item.data.mainImage,planImage:item.data.planImage,gallery:item.data.gallery??[],imageAlt:item.data.imageAlt})} href={adminUrl(item.data.pageSlug)}><span>{index+1}</span><div><b>{adminTitle(item.data.title)}</b><small>{item.data.area.toLocaleString("ru-RU")} м² · {item.data.floor} этаж{item.data.published===false?" · скрыт":""}</small></div></a>)}</nav><!-- TRILL_ADMIN_LIST_END --></aside>
<section class="work">
{current&&<form class="editor" data-admin-editor data-object-slug={current.data.pageSlug}><header class="editor-head"><div><small>Редактирование объекта</small><h2>{current.data.title}</h2></div><button type="submit" data-admin-save>Сохранить</button></header><div class="fields"><label class="wide visibility-toggle"><input type="checkbox" name="published" checked={current.data.published !== false}><span>Показывать офис на сайте</span><small>Снимите флажок, чтобы скрыть офис с сайта.</small></label>
<label class="wide"><span>Название объекта / карточки</span><input name="title" value={current.data.title}></label>
<label class="wide"><span>Заголовок страницы</span><input name="detailTitle" value={current.data.detailTitle}></label>
<label class="wide"><span>Адрес страницы — название можно менять независимо</span><input data-admin-slug value={current.data.pageSlug} readonly></label>
<label><span>Площадь, м²</span><input type="number" name="area" value={current.data.area}></label>
<label><span>Этаж</span><input name="floor" value={current.data.floor}></label>
<label><span>Ставка аренды, $/м²/месяц</span><input type="number" name="rentRate" min="0" step="0.01" value={current.data.rentRate}></label>
<label><span>Налог после ставки</span><select name="rentTax"><option value="НДС" selected={current.data.rentTax!=="НДФЛ"}>НДС</option><option value="НДФЛ" selected={current.data.rentTax==="НДФЛ"}>НДФЛ</option></select></label>
<label><span>Рабочие места</span><input name="workplaces" value={current.data.workplaces}></label>
<label><span>Готовность</span><input name="ready" value={current.data.ready}></label>
<label class="wide"><span>Планировка</span><input name="officeLayout" value={current.data.officeLayout}></label>
<label class="wide"><span>Описание</span><textarea name="intro" rows="4">{current.data.intro}</textarea></label>
<!-- TRILL_ADMIN_MEDIA_UI_START -->
<input type="hidden" name="mainImage" value={current.data.mainImage}>
<input type="hidden" name="planImage" value={current.data.planImage}>
<input type="hidden" name="gallery" value={JSON.stringify(current.data.gallery??[])}>
<section class="media wide"><div><h3>Главное фото</h3><p>Загрузите изображение для карточки и страницы офиса.</p></div><div class="media-grid" data-upload-output="main"><figure><img src={current.data.mainImage} alt={current.data.imageAlt}><code>{current.data.mainImage}</code></figure></div><label class="upload"><span>Загрузить или заменить</span><input type="file" accept="image/*" data-auto-upload="main"></label></section>
<section class="media wide"><div><h3>Планировка</h3><p>Изображение будет вписано целиком без обрезки.</p></div><div class="media-grid" data-upload-output="plan"><figure><img src={current.data.planImage} alt="Планировка офиса"><code>{current.data.planImage}</code></figure></div><label class="upload"><span>Загрузить или заменить</span><input type="file" accept="image/*" data-auto-upload="plan"></label></section>
<section class="media wide"><div><h3>Галерея</h3><p>Можно выбрать несколько изображений одновременно.</p></div><div class="media-grid" data-upload-output="gallery">{(current.data.gallery??[]).map((image)=><figure><img src={image} alt={current.data.imageAlt}><code>{image}</code></figure>)}</div><label class="upload"><span>Добавить фотографии</span><input type="file" accept="image/*" multiple data-auto-upload="gallery"></label></section>
<!-- TRILL_ADMIN_MEDIA_UI_END -->
</div><p data-admin-status>Изменения ещё не сохранены.</p></form>}
{current&&<div class="preview"><header><b>Предпросмотр страницы</b><a href={"/"+current.data.pageSlug+"/"} target="_blank">Открыть отдельно</a></header><iframe src={"/"+current.data.pageSlug+"/"} title="Предпросмотр офиса"></iframe></div>}
{!current&&<p class="empty">В коллекции пока нет офисов.</p>}
</section></main>
<style>*{box-sizing:border-box}body{margin:0;background:#ececec;color:#171717;font-family:Arial,sans-serif}.admin{display:grid;grid-template-columns:300px 1fr;min-height:100vh}aside{padding:22px;background:#242424;color:#fff}aside header,.editor-head,.preview header{display:flex;align-items:center;justify-content:space-between;gap:18px}aside h1{margin:4px 0 0}aside small{color:#aaa}aside button{width:38px;height:38px;border:0;border-radius:50%;font-size:24px}.item{display:grid;grid-template-columns:28px 1fr;gap:10px;margin:8px 0;padding:13px;border:1px solid #4b4b4b;background:#303030;color:#fff;text-decoration:none}.item.active{border-color:#fff;background:#3d3d3d}.item small{display:block;margin-top:5px}.work{min-width:0;padding:26px}.editor,.preview{padding:24px;background:#fff;border:1px solid #d0d0d0}.editor-head{margin-bottom:20px}.editor-head h2{margin:4px 0 0}.editor-head button{padding:12px 18px;border:0;background:#999;color:#fff}.fields{display:grid;grid-template-columns:1fr 1fr;gap:14px}.fields label{display:grid;gap:6px}.fields .wide{grid-column:1/-1}.fields span{font-size:12px;font-weight:700;color:#666}.fields input,.fields textarea,.fields select{width:100%;padding:10px;border:1px solid #bbb;background:#fafafa;font:inherit}.editor p{margin-bottom:0;color:#666;font-size:13px}.preview{margin-top:24px}.preview a{color:#111}.preview iframe{display:block;width:100%;height:720px;margin-top:14px;border:1px solid #ddd}.empty{padding:30px;background:#fff}@media(max-width:900px){.admin{grid-template-columns:1fr}.work{padding:14px}.fields{grid-template-columns:1fr}}/* TRILL_ADMIN_SAVE_UI_START */.editor-head button:disabled{background:#999;cursor:wait}[data-admin-status][data-state=dirty]{color:#8a5a00}[data-admin-status][data-state=saving]{color:#555}[data-admin-status][data-state=ok]{color:#167c3a}[data-admin-status][data-state=error]{color:#b42318}/* TRILL_ADMIN_SAVE_UI_END *//* TRILL_ADMIN_MEDIA_STYLE_START */.media{padding:18px;border:1px solid #ccc;background:#f5f5f5}.media h3{margin:0}.media p{margin:6px 0 14px}.upload{padding:14px;border:1px dashed #999;background:#fff}.media-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:10px;margin-bottom:12px}.media-grid figure{margin:0;padding:8px;border:1px solid #ddd;background:#fff}.media-grid img{display:block;width:100%;height:130px;object-fit:cover}.media-grid code{display:block;margin-top:7px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:11px}/* TRILL_ADMIN_MEDIA_STYLE_END *//* TRILL_ADMIN_NAMING_STYLE_START */aside [data-admin-add]{cursor:pointer;background:#fff;color:#222}.fields [data-admin-slug]{background:#eee;color:#666}/* TRILL_ADMIN_NAMING_STYLE_END */.visibility-toggle{display:grid!important;grid-template-columns:auto 1fr;align-items:center;gap:8px;padding:14px;border:1px solid #bbb;background:#f7f7f7}.visibility-toggle input{width:18px!important;height:18px}.visibility-toggle span{font-size:14px!important;color:#222!important}.visibility-toggle small{grid-column:2;color:#666}</style>
<!-- TRILL_ADMIN_SAVE_CLIENT_START --><script src="/js/trill-admin.js?v=6" defer></script><!-- TRILL_ADMIN_SAVE_CLIENT_END --><!-- TRILL_ADMIN_MEDIA_CLIENT_START --><script src="/js/trill-admin-media.js?v=1" defer></script><!-- TRILL_ADMIN_MEDIA_CLIENT_END --><script type="module" src="/js/trill-admin-switch.js?v=2"></script></body></html>
<!-- TRILL_ADMIN_SHELL_END -->
