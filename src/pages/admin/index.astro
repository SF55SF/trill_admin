---
import { getCollection } from "astro:content";
const offices=(await getCollection("offices")).sort((a,b)=>a.data.order-b.data.order);
const slug=Astro.url.searchParams.get("object");
const current=offices.find((item)=>item.data.pageSlug===slug)??offices[0];
const adminUrl=(value)=>"/admin/?object="+encodeURIComponent(value);
---
<!-- TRILL_ADMIN_SHELL_START -->
<!doctype html><html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow,noarchive"><title>Trilliant Admin</title></head><body>
<main class="admin">
<aside><header><div><small>TRILLIANT</small><h1>Офисы</h1></div><button type="button" disabled>+</button></header><nav>{offices.map((item,index)=><a class:list={["item",{active:item.id===current?.id}]} href={adminUrl(item.data.pageSlug)}><span>{index+1}</span><div><b>{item.data.title}</b><small>{item.data.area.toLocaleString("ru-RU")} м² · {item.data.floor} этаж</small></div></a>)}</nav></aside>
<section class="work">
{current&&<form class="editor" data-admin-editor data-object-slug={current.data.pageSlug}><header class="editor-head"><div><small>Редактирование объекта</small><h2>{current.data.title}</h2></div><button type="button" disabled>Сохранить</button></header><div class="fields">
<label class="wide"><span>Заголовок карточки</span><input name="title" value={current.data.title}></label>
<label class="wide"><span>Заголовок страницы</span><input name="detailTitle" value={current.data.detailTitle}></label>
<label><span>Площадь, м²</span><input type="number" name="area" value={current.data.area}></label>
<label><span>Этаж</span><input name="floor" value={current.data.floor}></label>
<label><span>Рабочие места</span><input name="workplaces" value={current.data.workplaces}></label>
<label><span>Готовность</span><input name="ready" value={current.data.ready}></label>
<label class="wide"><span>Планировка</span><input name="officeLayout" value={current.data.officeLayout}></label>
<label class="wide"><span>Описание</span><textarea name="intro" rows="4">{current.data.intro}</textarea></label>
</div><p>Каркас админки готов. Сохранение подключим следующим шагом.</p></form>}
{current&&<div class="preview"><header><b>Предпросмотр страницы</b><a href={"/"+current.data.pageSlug+"/"} target="_blank">Открыть отдельно</a></header><iframe src={"/"+current.data.pageSlug+"/"} title="Предпросмотр офиса"></iframe></div>}
{!current&&<p class="empty">В коллекции пока нет офисов.</p>}
</section></main>
<style>*{box-sizing:border-box}body{margin:0;background:#ececec;color:#171717;font-family:Arial,sans-serif}.admin{display:grid;grid-template-columns:300px 1fr;min-height:100vh}aside{padding:22px;background:#242424;color:#fff}aside header,.editor-head,.preview header{display:flex;align-items:center;justify-content:space-between;gap:18px}aside h1{margin:4px 0 0}aside small{color:#aaa}aside button{width:38px;height:38px;border:0;border-radius:50%;font-size:24px}.item{display:grid;grid-template-columns:28px 1fr;gap:10px;margin:8px 0;padding:13px;border:1px solid #4b4b4b;background:#303030;color:#fff;text-decoration:none}.item.active{border-color:#fff;background:#3d3d3d}.item small{display:block;margin-top:5px}.work{min-width:0;padding:26px}.editor,.preview{padding:24px;background:#fff;border:1px solid #d0d0d0}.editor-head{margin-bottom:20px}.editor-head h2{margin:4px 0 0}.editor-head button{padding:12px 18px;border:0;background:#999;color:#fff}.fields{display:grid;grid-template-columns:1fr 1fr;gap:14px}.fields label{display:grid;gap:6px}.fields .wide{grid-column:1/-1}.fields span{font-size:12px;font-weight:700;color:#666}.fields input,.fields textarea{width:100%;padding:10px;border:1px solid #bbb;background:#fafafa;font:inherit}.editor p{margin-bottom:0;color:#666;font-size:13px}.preview{margin-top:24px}.preview a{color:#111}.preview iframe{display:block;width:100%;height:720px;margin-top:14px;border:1px solid #ddd}.empty{padding:30px;background:#fff}@media(max-width:900px){.admin{grid-template-columns:1fr}.work{padding:14px}.fields{grid-template-columns:1fr}}</style>
</body></html>
<!-- TRILL_ADMIN_SHELL_END -->
