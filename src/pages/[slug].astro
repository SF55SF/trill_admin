---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { absoluteUrl, homeAnchor, relativePath } from '../lib/paths';
import { isOfficePublic } from '../lib/offices';

export async function getStaticPaths() {
  const offices = (await getCollection('offices')).filter((office) => isOfficePublic(office.data));

  return offices.map((office) => ({
    params: { slug: office.data.pageSlug },
    props: { office },
  }));
}

const { office } = Astro.props as { office: CollectionEntry<'offices'> };
const data = office.data;
const rentRate = data.rentRate > 0 ? "$" + new Intl.NumberFormat("ru-RU", { maximumFractionDigits: 2 }).format(data.rentRate) + " / м² / мес." : "По запросу";

const currentPath = Astro.url.pathname;
const canonical = absoluteUrl(`/${data.pageSlug}/`);
const mainImage = relativePath(data.mainImage, currentPath);
const gallery = data.gallery.map((image) => relativePath(image, currentPath));
---

<BaseLayout
  title={data.seoTitle}
  description={data.description}
  canonical={canonical}
  image={absoluteUrl(data.mainImage)}
>
  <Header />

  <main>
    <section class="section office-detail-page">
      <div class="container two-col">
        <div>
          <p class="eyebrow">Офис {data.area} м²</p>

          <h1 class="office-detail-title">
            {data.detailTitle}
          </h1>

          <p>{data.intro}</p>

          <div class="office-detail-meta">
            <p><strong>Планировка</strong><span>{data.officeLayout}</span></p>
            <p><strong>Ставка аренды</strong><span>{rentRate}</span><small>не включая эксплуатацию и налоги.</small></p>
          </div>

          <ul class="feature-list">
            {data.detailFeatures.map((feature) => <li>{feature}</li>)}
          </ul>

          <div class="card-actions">
            <a class="button button-dark" href="#contacts">
              Получить предложение
            </a>

            <a class="button" href={homeAnchor('offices', currentPath)}>
              Все офисы
            </a>
          </div>
        </div>

        <div class="plan-placeholder">
          <button
            class="image-open-button"
            type="button"
            data-lightbox-src={mainImage}
            data-lightbox-alt={data.imageAlt}
            aria-label={`Открыть фото офиса ${data.area} м²`}
          >
            <img
              class="office-detail-main-image"
              src={mainImage}
              alt={data.imageAlt}
            />
          </button>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <p class="eyebrow">Фото офиса</p>
        <h2>Галерея офиса {data.area} м²</h2>

        <div class="mini-gallery">
          {gallery.map((image, index) => (
            <div>
              <button
                class="image-open-button"
                type="button"
                data-lightbox-src={image}
                data-lightbox-alt={`Фото ${index + 1} офиса ${data.area} м² в БЦ Trilliant`}
                aria-label={`Открыть фото ${index + 1} офиса ${data.area} м²`}
              >
                <img
                  class="office-detail-gallery-image"
                  src={image}
                  alt={`Фото ${index + 1} офиса ${data.area} м² в БЦ Trilliant`}
                />
              </button>
            </div>
          ))}
        </div>
      </div>
    </section>

    <Contact />
  </main>

  <Footer />
</BaseLayout>