---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { absoluteUrl, homeAnchor, relativePath } from '../lib/paths';
import { isOfficePublic } from '../lib/offices';

export async function getStaticPaths() {
  const offices = (await getCollection('offices')).filter((office) => isOfficePublic(office.data));

  return offices.map((office) => ({
    params: { slug: office.data.pageSlug },
    props: { office },
  }));
}

const { office } = Astro.props as { office: CollectionEntry<'offices'> };
const data = office.data;
const displayTitle = data.detailTitle.startsWith("Офисный блок ") ? data.detailTitle.slice("Офисный блок ".length) : data.detailTitle;
const detailFeatures = data.detailFeatures.filter((feature) => !feature.toLowerCase().includes("планировк"));
const rentRate = data.rentRate > 0 ? "$" + new Intl.NumberFormat("ru-RU", { maximumFractionDigits: 2 }).format(data.rentRate) + " / м² / мес." : "По запросу";

const currentPath = Astro.url.pathname;
const canonical = absoluteUrl(`/${data.pageSlug}/`);
const mainImage = relativePath(data.mainImage, currentPath);
const gallery = data.gallery.map((image) => relativePath(image, currentPath));
---

<BaseLayout
  title={data.seoTitle}
  description={data.description}
  canonical={canonical}
  image={absoluteUrl(data.mainImage)}
>
  <Header />

  <main>
    <section class="section office-detail-page">
      <div class="container two-col">
        <div>
          <p class="eyebrow">Офис {data.area} м²</p>

          <h1 class="office-detail-title">
            {displayTitle}
          </h1>

          <p>{data.intro}</p>

          <div class="office-detail-meta office-card-topline">
            <p class="office-rent-box"><strong>Ставка аренды</strong><span>{rentRate}</span><small>не включая эксплуатацию и {data.rentTax}.</small></p>
            <a class="button button-telegram telegram-icon-button" href="https://t.me/sanjar_saymatov_cmwp" target="_blank" rel="noreferrer" aria-label="Написать в Telegram" title="Telegram">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21.6 3.4 18.4 19c-.2 1.1-.8 1.4-1.7.9l-4.9-3.6-2.4 2.3c-.3.3-.5.5-1 .5l.4-5 9.1-8.2c.4-.4-.1-.6-.6-.2L6.1 12.8 1.3 11.3C.3 11 .3 10.3 1.5 9.8L20.2 2.6c.9-.3 1.7.2 1.4.8Z" /></svg>
            </a>
          </div>

          <ul class="feature-list">
            {detailFeatures.map((feature) => <li>{feature}</li>)}
          </ul>

          <p class="office-layout-row"><strong>Планировка</strong><span>{data.officeLayout}</span></p>

          <div class="card-actions">
            <a class="button button-dark" href="#contacts">
              Получить предложение
            </a>

            <a class="button" href={homeAnchor('offices', currentPath)}>
              Все офисы
            </a>
          </div>
        </div>

        <div class="plan-placeholder">
          <button
            class="image-open-button"
            type="button"
            data-lightbox-src={mainImage}
            data-lightbox-alt={data.imageAlt}
            aria-label={`Открыть фото офиса ${data.area} м²`}
          >
            <img
              class="office-detail-main-image"
              src={mainImage}
              alt={data.imageAlt}
            />
          </button>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <p class="eyebrow">Фото офиса</p>
        <h2>Галерея офиса {data.area} м²</h2>

        <div class="mini-gallery">
          {gallery.map((image, index) => (
            <div>
              <button
                class="image-open-button"
                type="button"
                data-lightbox-src={image}
                data-lightbox-alt={`Фото ${index + 1} офиса ${data.area} м² в БЦ Trilliant`}
                aria-label={`Открыть фото ${index + 1} офиса ${data.area} м²`}
              >
                <img
                  class="office-detail-gallery-image"
                  src={image}
                  alt={`Фото ${index + 1} офиса ${data.area} м² в БЦ Trilliant`}
                />
              </button>
            </div>
          ))}
        </div>
      </div>
    </section>

    <Contact />
  </main>

  <Footer />
</BaseLayout>